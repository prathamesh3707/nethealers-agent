# Copy this file to .env and fill in what you have. .env is private: it is never committed.
# The agent works without any key (offline rules); keys switch on the language-model roles.

# Order in which providers are tried. Remove the ones you don't use.
LLM_PROVIDERS=openrouter,groq,gemini,ollama

# OpenRouter (free models): create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Tried in this order; OpenRouter moves to the next one if a model is busy or down.
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,openrouter/free

# OpenAI (paid): add "openai" to LLM_PROVIDERS to use it
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional backups
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# A model on this laptop via Ollama, e.g. OLLAMA_MODEL=qwen3:8b
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434/v1

# Decision log and document library (docker compose up -d starts this database)
DATABASE_URL=postgresql://nethealers:nethealers@localhost:5435/nethealers

# Knowledge base: local (default) or a remote one, e.g. the ITU AI for Good Sandbox (see docs/sandbox_day.md).
# Searches fall back to the local index whenever the remote one fails.
KB_BACKEND=local
KB_REMOTE_URL=
